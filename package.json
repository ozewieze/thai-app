{
  "name": "thai-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:vocab": "node scripts/generate-vocabulary-seed.mjs",
    "seed:grammar": "node scripts/generate-grammar-seed.mjs",
    "seed:pattern": "node scripts/generate-pattern-seed.mjs",
    "db:reset": "npm run seed:vocab && npm run seed:grammar && npm run seed:pattern && npx supabase db reset",
    "db:reset:full": "npm run db:reset && node --env-file=.env.local scripts/generate-audio.mjs && node --env-file=.env.local scripts/merge-audio.mjs && node --env-file=.env.local scripts/upload-slides.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.104.0",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "typescript": "^5"
  }
}
